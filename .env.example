# Copier en .env (non versionné) puis renseigner.
# Connexion Snowflake CLI (~/.snowflake/connections.toml)
SNOWFLAKE_CONNECTION=MA_CONNEXION
# SELECT CURRENT_ORGANIZATION_NAME() || '-' || CURRENT_ACCOUNT_NAME();
SNOWFLAKE_ACCOUNT_ID=MONORG-MONCOMPTE
# Utilisateur Snowflake qui déploie (reçoit DCM_ADMIN et DCP_TESTER)
SNOWFLAKE_USER=MON_USER
